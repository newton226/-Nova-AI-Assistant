<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nova_background">

    <!-- Nova Logo/Avatar -->
    <ImageView
        android:id="@+id/novaAvatar"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/nova_avatar"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/novaText"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Nova Status Text -->
    <TextView
        android:id="@+id/novaText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nova_ready"
        android:textColor="@color/nova_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/novaAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/responseText"
        android:layout_marginTop="16dp" />

    <!-- Response Text -->
    <TextView
        android:id="@+id/responseText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/nova_greeting"
        android:textColor="@color/nova_text_secondary"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/novaText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/pulseAnimation"
        android:layout_marginTop="32dp" />

    <!-- Pulse Animation View -->
    <View
        android:id="@+id/pulseAnimation"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/pulse_background"
        app:layout_constraintTop_toBottomOf="@id/responseText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/speakButton"
        android:layout_marginTop="32dp" />

    <!-- Speak Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/speakButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_mic"
        android:contentDescription="@string/tap_to_speak"
        app:backgroundTint="@color/nova_primary"
        app:fabSize="normal"
        app:tint="@color/nova_text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="64dp" />

    <!-- Status Bar -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/nova_text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
